# ─── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Build Outputs ────────────────────────────────────────────
dist/
dist-ssr/
build/
out/
.output/

# ─── Environment Variables (NEVER commit these) ───────────────
.env
.env.*
!.env.example       # .env.example IS safe to commit (it has no real secrets)

# ─── Secrets / Keys ───────────────────────────────────────────
*.pem
*.key
*.crt
*.p12
secrets.json
credentials.json

# ─── Editor & IDE ─────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── OS Files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ─── Cache ────────────────────────────────────────────────────
.cache/
.parcel-cache/
.eslintcache
*.tsbuildinfo

# ─── Testing ──────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Temporary / Scratch files ────────────────────────────────
*.local
*.tmp
*.temp
tmp/
temp/

# ─── Uploads (local dev only, use Cloudinary in production) ───
uploads/
public/uploads/

# ─── Bolt (AI tool artifacts) ─────────────────────────────────
.bolt/

# ─── Misc ─────────────────────────────────────────────────────
*.tgz
package-lock.json   # Uncomment if you prefer to not commit lock files
                    # (most projects DO commit this — remove the # to ignore it)